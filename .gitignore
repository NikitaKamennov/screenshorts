# Publish source code, public documentation and dependency notices only.
# New root files/directories and public docs need an explicit entry here.
/*
!/.gitignore
!/.gitattributes
!/.env.example
!/README.md
!/CONTRIBUTING.md
!/LICENSE
!/THIRD-PARTY.md
!/go.mod
!/go.sum
!/build-windows.cmd
!/build-portable.cmd
!/build-release.cmd
!/cmd/
!/config/
!/frontend/
!/internal/
!/licenses/
!/schemas/
!/scripts/
!/workers/
!/docs/

# Keep local plans, release assets and working notes outside the public tree.
/docs/*
!/docs/README.md
!/docs/user-guide.md
!/docs/shelf.md
!/docs/project-status.md
!/docs/roadmap.md
!/docs/product-spec.md
!/docs/data-format.md
!/docs/branding.md
!/docs/scaffold-provenance.md
!/docs/local-workers.md
!/docs/background-removal.md
!/docs/build-linux.md
!/docs/linux-portable.md
!/docs/linux-download-spec.txt
!/docs/windows-build.md
!/docs/windows-quick-build.md
!/docs/windows-acceptance.md
!/docs/windows-notices.md
!/docs/github-publication.md

# Local data and generated directories at any depth.
.local-data/
.local-notes/
.screenshorts-trash/
.cache/
.history/
.idea/
.vscode/
dist/
build/
library/
models/
runtime/
node_modules/
.venv/
venv/
__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
/frontend/wailsjs/
settings.json
*.local.json
*.local.yaml
*.local.yml
*-private.*
ScreenShooter Pro*.txt
ScreenShorts Pro*.txt
скринполка-текст.txt

