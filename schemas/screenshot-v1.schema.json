{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skrinpolka:screenshot:v1",
  "title": "ScreenShorts Pro screenshot sidecar v1",
  "type": "object",
  "required": ["schema", "id", "image_file", "created_at", "width", "height", "note", "tags", "ocr", "image_sha256"],
  "properties": {
    "schema": {"const": "skrinpolka-screenshot-v1"},
    "id": {"type": "string", "pattern": "^(?:[0-9a-f]{32}|(?:ScreenShorts Pro|Скринполка) [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}-[0-9]{2}-[0-9]{2}(?: \\((?:[2-9]|[1-9][0-9]{1,2}|1000)\\))?)$"},
    "image_file": {"type": "string", "pattern": "^(?:[0-9a-f]{32}|(?:ScreenShorts Pro|Скринполка) [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}-[0-9]{2}-[0-9]{2}(?: \\((?:[2-9]|[1-9][0-9]{1,2}|1000)\\))?)\\.png$"},
    "created_at": {"type": "string", "format": "date-time"},
    "width": {"type": "integer", "minimum": 1, "maximum": 16000000},
    "height": {"type": "integer", "minimum": 1, "maximum": 16000000},
    "note": {"type": "string", "maxLength": 32768},
    "metadata_revision": {"type": "integer", "minimum": 1},
    "image_revision": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "ocr": {
      "type": "object",
      "required": ["status", "raw_text", "corrected_text"],
      "properties": {
        "status": {"type": "string"},
        "raw_text": {"type": "string"},
        "corrected_text": {"type": "string"},
        "has_correction": {"type": "boolean", "description": "When true, corrected_text is authoritative, including an intentional empty string."},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "engine": {"type": "string"},
        "model_revision": {"type": "string"},
        "completed_at": {"type": "string", "format": "date-time"},
        "error": {"type": "string"},
        "session_id": {"type": "string"}
      }
    },
    "image_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  },
  "$comment": "Core additionally validates calendar dates and canonical filename suffixes, width*height <= 16000000, UTF-8 note byte length <= 32768, each OCR text <= 512 KiB when merging, sidecar <= 1 MiB, ID/filename agreement, PNG size <= 20 MiB and SHA-256. Legacy hex IDs remain readable. Metadata_digest is a computed UI field, never persisted. OCR status remains an open string for compatible extensions. Schema is a documentation artifact; no external validator is invoked."
}
